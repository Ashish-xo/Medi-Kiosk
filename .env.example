# ============================================================
# MediKiosk — Environment Variables
# ============================================================
# PostgreSQL connection string (Railway provides this automatically)
DATABASE_URL=postgres://user:pass@host:5432/medi_kiosk

# Server port (Railway sets this automatically)
PORT=4000

# AI clinical summarizer (organizes intake data — never diagnoses)
# Defaults to api.b.ai with the HERMES_CUSTOM_API_B_AI_API_KEY env var
AI_URL=https://api.b.ai/v1/chat/completions
AI_MODEL=deepseek-v4-flash-vision-exp
# AI_KEY=          # Falls back to HERMES_CUSTOM_API_B_AI_API_KEY if set

# Where the QR code points the doctor (set to your deployed URL)
# Example: DOCTOR_URL=https://medi-kiosk.up.railway.app/doctor
DOCTOR_URL=http://localhost:4000/doctor