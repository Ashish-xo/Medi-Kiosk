# ── MediKiosk server config — copy to .env and fill in real values ──
PORT=4000
# Railway provides this automatically when you attach their Postgres plugin
DATABASE_URL=postgres://user:pass@host:5432/db

# AI summarizer (OpenAI-compatible). Reuse a b.ai key — keep it OUT of git.
AI_URL=https://api.b.ai/v1/chat/completions
AI_KEY=
AI_MODEL=deepseek-v4-flash-vision-exp

# Speech-to-text provider: whisper (local/offline) | google | auto
#   auto = whisper if the local venv exists (hospital/offline), else google (server deploy)
#   whisper = local faster-whisper — no internet, best for the kiosk demo
#   google  = Google free endpoint (needs GOOGLE_STT_KEY below)
STT_PROVIDER=auto
# Whisper model size: base (fastest, ~150MB) | small (balanced, ~460MB) | medium | large-v3 (best Hindi)
WHISPER_MODEL=small

# Google speech-to-text key (only needed if STT_PROVIDER=google or auto-without-whisper)
GOOGLE_STT_KEY=

# Doctor console PIN — CHANGE THIS. Patient side never needs it.
DOCTOR_PIN=medikiosk-demo

# Origins allowed to call the API from a browser (comma-separated).
# Same-origin requests don't need CORS; add your deployed URL + localhost dev.
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:3000

# Where QR codes point the doctor (the deployed doctor console URL)
DOCTOR_URL=https://your-app.up.railway.app/doctor
